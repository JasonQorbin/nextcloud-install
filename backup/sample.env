# Configuration for NextCloud backup script

# VPS details
# ===========

# VPS user name and host. These are used to ssh to user@host. 
VPS_USER=
VPS_HOST=
# Local path to ssh key
VPS_KEY=
# Path on the server to the docker compose file
VPS_COMPOSE_PATH=


# Borg backup details
# ===================

# Local path to borg repo
BORG_REPO=
# Encryption passphrase for the backup
BORG_PASSPHRASE=
